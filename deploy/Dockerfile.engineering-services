FROM python:3.13-slim
WORKDIR /work
RUN apt-get update && apt-get install -y --no-install-recommends gcc && rm -rf /var/lib/apt/lists/*
COPY engineering ./engineering
COPY scripts/bootstrap_engineering_pki.py ./scripts/bootstrap_engineering_pki.py
RUN pip install --no-cache-dir fastapi uvicorn cryptography pydantic
CMD ["python","engineering/services/adapter_daemon.py","--host","0.0.0.0","--port","8093"]
